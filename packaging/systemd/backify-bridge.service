[Unit]
Description=Backify Bridge (reverse-tunnel access broker)
Documentation=https://github.com/backifyapp/bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/backify-bridge run
Restart=always
RestartSec=5
# Runs as a dedicated, unprivileged user.
User=backify-bridge
Group=backify-bridge
# Hardening (least privilege): the agent only needs to read its config and use the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Only writable path: the config directory.
ReadWritePaths=/etc/backify-bridge
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
