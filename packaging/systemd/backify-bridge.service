[Unit]
Description=Backify Bridge (broker de acesso via túnel reverso)
Documentation=https://github.com/backifyapp/bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/backify-bridge run
Restart=always
RestartSec=5
# Roda como usuário dedicado, sem privilégios.
User=backify-bridge
Group=backify-bridge
# Endurecimento (menor privilégio): o agent só precisa ler o config e falar rede.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Único caminho gravável: o diretório do config.
ReadWritePaths=/etc/backify-bridge
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
